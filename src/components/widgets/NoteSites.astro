---
import { noteSites } from '@/data/profile'
import type { Lang } from '@/i18n'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
// Shown at the right of each row: the host, plus the path for sites under github.io
const host = (href: string) => {
  const url = new URL(href)
  const name = url.host.replace(/^www\./, '')
  return name.endsWith('github.io') ? name + url.pathname.replace(/\/$/, '') : name
}
---

<ul class="note-sites">
  {noteSites.map((site) => (
    <li>
      <a href={site.href} target="_blank" rel="noopener">
        <p class="site-title">
          {site.title[lang]}
          <span class="site-note">{site.note[lang]}</span>
        </p>
        <div class="divider" />
        <p class="site-host">
          {host(site.href)}
          <span aria-hidden="true"> ↗</span>
        </p>
      </a>
    </li>
  ))}
</ul>

<style>
  .note-sites {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.4375rem 0;
    color: var(--text-primary);
    text-decoration: none;
    transition: opacity 0.15s ease-out;
  }
  @media (hover: hover) and (pointer: fine) {
    .note-sites:hover a {
      opacity: 0.4;
    }
    .note-sites:hover a:hover {
      opacity: 1;
    }
  }
  p {
    margin: 0;
  }
  .site-title {
    flex: 0 1 auto;
    min-width: 0;
    line-height: 1.6;
  }
  .site-note {
    margin-left: 0.5rem;
    font-size: var(--font-size-s);
    color: var(--text-secondary);
  }
  .divider {
    flex: 1 1 auto;
    min-width: 1.5rem;
    margin: 0 0.25rem;
    height: 0.5px;
    background-color: var(--border);
    align-self: center;
  }
  .site-host {
    flex-shrink: 0;
    white-space: nowrap;
    font-size: var(--font-size-s);
    color: var(--text-secondary);
  }
  @media (max-width: 480px) {
    .divider {
      background-color: transparent;
      min-width: 0.5rem;
    }
    .site-note {
      display: block;
      margin-left: 0;
    }
  }
</style>
